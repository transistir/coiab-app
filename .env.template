# Replace <replace_me> with the relevant values 

## Used at run time

APP_VARIANT=development
MAPBOX_ACCESS_TOKEN=<replace_me>
COMAPEO_METRICS_URL=<replace_me>
COMAPEO_METRICS_API_KEY=<replace_me>

## Sentry

# SENTRY_DSN is optional; the default (project transistir/coiab-app) is baked
# into app.config.js.
# SENTRY_DSN=

# Source-map upload is disabled (SENTRY_DISABLE_AUTO_UPLOAD=true). To enable
# it locally, export SENTRY_AUTH_TOKEN and set SENTRY_DISABLE_AUTO_UPLOAD=false.
# When you enable it, set SENTRY_DSN to the same project as SENTRY_ORG/SENTRY_PROJECT;
# otherwise source maps go to one project while events go to another.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SENTRY_DISABLE_AUTO_UPLOAD=true

## Feature flags (can generally leave these commented out and uncomment when needed)

# EXPO_PUBLIC_FEATURE_TEST_DATA_UI=true
# EXPO_PUBLIC_FEATURE_MEDIA_MANAGER=true
