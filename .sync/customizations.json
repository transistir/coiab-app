{
  "version": 1,
  "fork": "coiab-app",
  "parent": "transistir/comapeo-mobile-1",
  "upstream": "digidem/comapeo-mobile",
  "base_branch": "develop",
  "classes": {
    "fork-only": "Exists in this fork and must NOT exist in the parent trunk. Directory-level; no per-file decisions.",
    "shared-infra": "Exists in the parent; the parent owns it. Reconcile integration files, preserve capability and product scenarios.",
    "product": "Exists upstream and here. Classified per rule.",
    "incoming-upstream": "New upstream file absent here. Must receive an explicit adopt/reject/defer disposition before merge."
  },
  "rules": [
    {
      "id": "coiab.identity",
      "class": "product",
      "policy": "preserve-values",
      "paths": ["app.json", "app.config.js", "eas.json", "expo-config-plugins/customPermissionText.js", "assets/icon.png", "assets/splash.png", "assets/adaptive-icon.png"],
      "named_values": [
        "app name CoiabApp",
        "slug and scheme ekanadyby",
        "APP_ID_BASE org.coiab",
        "APP_NAME_BASE CoiabApp",
        "EAS project 528d108c-46da-4447-a6f2-774248724cde",
        "Sentry organization transistir, project coiab-app",
        "splash backgroundColor #DABA8D"
      ],
      "reject_incoming": ["assets/icon-ios.png", "splash #0332AD / imageWidth 184", "digidem ascAppId"],
      "evidence": ["app.config.test.ts", "src/frontend/lib/appConfig.test.ts"]
    },
    {
      "id": "coiab.branding-copy",
      "class": "product",
      "policy": "reconcile",
      "paths": ["messages/**", "src/frontend/screens/PrivacyPolicy/privacyPolicyMessages.ts", "src/frontend/images/**"],
      "intent": "Reconcile catalog source keys; regenerated translations are never hand-merged. Branding tests use noComapeoBrand and visibleTerminology; no aggregate word counts.",
      "evidence": ["src/frontend/lib/noComapeoBrand.test.ts", "src/frontend/lib/visibleTerminology.test.ts"]
    },
    {
      "id": "coiab.storybook",
      "class": "shared-infra",
      "policy": "reconcile",
      "paths": [".rnstorybook/**", "src/frontend/flows/**", "scripts/storybook-*", ".github/workflows/storybook-capture.yml", "src/**/*.stories.tsx"],
      "intent": "Preserve capture capability and COIAB product scenarios; reconcile integration files and dependency versions. A preserved harness may call removed APIs."
    },
    {
      "id": "coiab.ci-apk",
      "class": "shared-infra",
      "policy": "reconcile",
      "paths": [".github/workflows/ci.yml", ".github/workflows/build-apk.yml", "scripts/build-*", "scripts/upload-release.sh", "docs/ApkBuild.md"],
      "intent": "Named workflow requirements plus reconciliation. Category-package generation and delivery stay. General translation/polyfill infra is not frozen."
    },
    {
      "id": "coiab.onboarding-upstream",
      "class": "product",
      "policy": "reconcile",
      "paths": ["src/frontend/screens/Onboarding/DataPrivacy.tsx", "src/frontend/screens/Onboarding/DeviceNaming.tsx", "src/frontend/screens/Onboarding/IntroToCoMapeo.tsx", "src/frontend/screens/Onboarding/Success.tsx", "src/frontend/screens/Onboarding/OnboardingPrivacyPolicy.tsx", "src/frontend/Navigation/Stack/OnboardingScreens.tsx"],
      "intent": "Protect persisted profile state, catalogs, autocomplete and observation-profile consumers."
    },
    {
      "id": "coiab.onboarding-fork",
      "class": "fork-only",
      "policy": "fork-only",
      "paths": ["src/frontend/screens/Onboarding/CreateOrganization*", "src/frontend/screens/Onboarding/JoinOrganizationIntro*", "src/frontend/screens/Onboarding/OrganizationProvisioning*", "src/frontend/screens/Onboarding/VillageEntry*", "src/frontend/screens/Onboarding/EthnicGroupSelection*", "src/frontend/screens/Onboarding/OnboardingCompactHeader*"]
    },
    {
      "id": "coiab.navigation",
      "class": "product",
      "policy": "reconcile",
      "paths": ["src/frontend/Navigation/Stack/index.tsx", "src/frontend/Navigation/Stack/AppScreens.tsx", "src/frontend/Navigation/Stack/DeepLinkListener.tsx", "src/frontend/Navigation/Tab/**", "src/frontend/sharedTypes/navigation.ts", "src/frontend/App.tsx", "src/frontend/sharedComponents/DrawerMenu.tsx", "src/frontend/sharedComponents/HomeHeader.tsx"],
      "intent": "Adapt product behaviour to upstream interfaces; never replace product route declarations."
    },
    {
      "id": "coiab.org-layer",
      "class": "fork-only",
      "policy": "fork-only",
      "paths": ["src/frontend/lib/organization/**", "src/frontend/hooks/organization/**", "src/frontend/screens/Organizations*", "src/frontend/hooks/server/useValidarArquivoRemoto.ts", "docs/specs/organizacao/**", "docs/specs/SPEC-46*"],
      "intent": "Org-layer modules are product-only. Integration surfaces that also exist upstream (AppProviders.tsx, screens/RemoteArchive/**) are product/reconcile, not fork-only."
    },
    {
      "id": "coiab.persisted-state",
      "class": "product",
      "policy": "reconcile",
      "paths": ["src/frontend/contexts/**", "src/frontend/AppProviders.tsx", "src/frontend/PersistedStores/**", "src/frontend/screens/RemoteArchive/**"],
      "intent": "Upgrade/restart evidence required with pre-sync persisted data."
    },
    {
      "id": "coiab.deleted-upstream-surfaces",
      "class": "product",
      "policy": "deleted-here",
      "paths": ["src/frontend/screens/AllProjects.tsx", "src/frontend/screens/Categories.tsx", "src/frontend/screens/ProjectCreation/**", "src/frontend/screens/ProjectSettings/EditProjectDetails.tsx", "src/frontend/screens/YourTeam/InviteCollaborators.tsx", "src/frontend/screens/YourTeam/LeaveProject.tsx", "src/frontend/screens/YourTeam/LeaveProjectWarning.tsx", "src/frontend/screens/YourTeam/LeftProjectConfirmation.tsx", "src/frontend/screens/Onboarding/MapOnYourOwnIntro.tsx", "src/frontend/images/CoMapeoLogo.svg", "src/frontend/images/CoMapeoShield.svg", "src/frontend/images/CoMapeoText.svg", "src/frontend/hooks/useIsLastCoordinator*", "src/frontend/hooks/useIsLastMember*", "src/frontend/hooks/useOpenDrawer.ts", "tests/e2e/specs/onboarding/join-project-intro.test.ts", "tests/e2e/specs/onboarding/map-on-your-own-intro.test.ts"],
      "intent": "Protect against resurrection via route registration and imports, not filename absence alone. Six tombstoned files were modified upstream; each needs a dropped-change line."
    },
    {
      "id": "coiab.back-prevention",
      "class": "product",
      "policy": "reconcile",
      "paths": ["src/frontend/hooks/usePreventAndroidBackButton.ts", "src/frontend/sharedComponents/BottomSheetWrapper.tsx", "src/frontend/screens/BackgroundMaps/**", "src/frontend/screens/YourTeam/ReviewAndInvite/WaitingForInviteAccept.tsx", "src/frontend/screens/SaveTrack/SaveTrackScreen.tsx"],
      "intent": "Migrate unconditional callers to usePreventBackNavigation; keep the conditional BottomSheetWrapper behaviour as a recorded deviation with tests."
    },
    {
      "id": "coiab.theme",
      "class": "product",
      "policy": "reconcile",
      "paths": ["src/frontend/lib/styles.ts", "src/frontend/lib/brandColors.ts", "src/frontend/constants.ts"],
      "intent": "COIAB palette preserved; upstream layout constants adopted; styles.test.ts and brandColors.test.ts green in the merge."
    },
    {
      "id": "coiab.dependencies",
      "class": "shared-infra",
      "policy": "upstream-wins",
      "paths": ["package.json", "package-lock.json", "patches/**"],
      "intent": "Upstream dependency set; fork-only devDependencies and scripts retained by name. Lockfile regenerated from the incoming lock. Patch selectors by exact package name and version."
    },
    {
      "id": "coiab.patch-maplibre",
      "class": "product",
      "policy": "deleted-here",
      "paths": ["patches/@maplibre+maplibre-react-native+10.4.2.patch"],
      "intent": "Upstream-originated patch (added 0e257120, deleted 3383c6df with the MapLibre 11 move). Do not keep behind a version selector; prove the Android map-zoom fix on 11.4.1."
    },
    {
      "id": "coiab.patch-expo-file-system",
      "class": "product",
      "policy": "generated",
      "paths": ["patches/expo-file-system+56.0.11.patch", "patches/expo-file-system+56.0.11+001+buffer-upload-reads.patch"],
      "intent": "The old 56.0.8 patch is a rename of 56.0.11.patch (same blob); the duplicate 56.0.8+001 is removed; the buffer-upload fix is renamed to 56.0.11+001 so patch-package applies it. Verify with patch-package --error-on-fail."
    },
    {
      "id": "coiab.test-infra",
      "class": "shared-infra",
      "policy": "reconcile",
      "paths": ["jest.config.js", "jest.setup.js", "scripts/jest/**", "tests/**", "eslint.config.mjs", "metro.config.js", "expo-config-plugins/increaseJavaMemory.js", "expo-config-plugins/targetArmArchsOnly.js"]
    },
    {
      "id": "coiab.packages-i18n",
      "class": "fork-only",
      "policy": "fork-only",
      "paths": ["assets/categorias/**", "scripts/gerar-manifestos-pacotes*", "scripts/verificar-pacotes-entrega*", "scripts/check-message-catalog*"],
      "intent": "Added package assets/modules are fork-only; existing Metro and package hooks require reconciliation."
    },
    {
      "id": "coiab.incoming-upstream",
      "class": "incoming-upstream",
      "policy": "adopt-or-record",
      "paths": ["src/frontend/sharedComponents/HeaderRightContainer.tsx", "src/frontend/sharedComponents/PermissionButtons.tsx", "src/frontend/screens/MapScreen/TrackBottomSheet/TrackPermissionScreen.tsx", "src/frontend/lib/internetStatus.ts", "src/frontend/lib/fonts.ts", "expo-config-plugins/disableLocationNotificationBadge.js"],
      "intent": "Every new upstream file needs one disposition: adopt, reject, or defer with an issue. Generated coverage report lists all of them."
    }
  ],
  "coverage": {
    "rule": "Generated by scripts/sync/check-customizations.mjs; every path that differs from the recorded parent SHA must match a rule or be listed in the generated report with a disposition.",
    "fail_closed": true
  }
}
